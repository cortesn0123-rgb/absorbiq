/**
 * Writes the SQL that seeds public.absorption_factors from lib/bioavailability/factors.ts.
 *
 *   npm run db:absorption-seed > supabase/migrations/<timestamp>_absorption_factors.sql
 *
 * Re-run it into a new migration whenever factors.ts changes; lib/bioavailability/factors.test.ts
 * checks that the latest seed migration matches the file.
 */

import { FACTOR_ROWS } from "../lib/bioavailability/factors.ts";

const quote = (text: string) => `'${text.replace(/'/g, "''")}'`;

const values = FACTOR_ROWS.map(
  (r) =>
    `  (${quote(r.nutrient)}, ${quote(r.key)}, ${r.value}, ${r.low}, ${r.high}, ${quote(r.description)}, ${quote(r.source)})`,
).join(",\n");

// Rows no longer in factors.ts are deleted, so the table matches the file exactly.
const keys = FACTOR_ROWS.map((r) => `(${quote(r.nutrient)}, ${quote(r.key)})`).join(",\n  ");

process.stdout
  .write(`-- Absorption factors for lib/bioavailability. Generated by scripts/absorption-seed.mts from
-- lib/bioavailability/factors.ts; do not edit by hand. Plain-English notes: docs/bioavailability.md.

alter table public.absorption_factors add column if not exists description text;

delete from public.absorption_factors
where (nutrient_id, condition_key) not in (
  ${keys}
);

insert into public.absorption_factors
  (nutrient_id, condition_key, factor, low, high, description, source_citation)
values
${values}
on conflict (nutrient_id, condition_key) do update set
  factor = excluded.factor,
  low = excluded.low,
  high = excluded.high,
  description = excluded.description,
  source_citation = excluded.source_citation;
`);
