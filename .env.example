# Copy to .env.local and fill in. Never commit .env.local.
# Production: add the same five variables in Vercel > Project > Settings > Environment Variables.
# A missing one is logged at server start ("[env] Missing environment variables").

# USDA FoodData Central — https://fdc.nal.usda.gov/api-key-signup
FDC_API_KEY=

# Anthropic Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Supabase — Project Settings > API. URL looks like https://<ref>.supabase.co;
# the anon key is the "publishable" key (sb_publishable_...), never a secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Bypasses Row Level Security.
# Supabase > Project Settings > API Keys > Secret keys. Used to write the FDC food cache.
SUPABASE_SECRET_KEY=
